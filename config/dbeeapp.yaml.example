provider_dir: /etc/dbeeapp/providers

providers:
  cyberark_aim:
    base_url: https://aim.example.invalid
    app_id: DBeeApp
    account_parameter: Object
    ca_file: /etc/pki/tls/certs/ca-bundle.crt
    timeout: 10

timeouts:
  connect: 10
  provider: 20
  sql: 60

session:
  mode: reuse

postgresql:
  ssl_mode: verify-full
  ca_file: /etc/pki/tls/certs/ca-bundle.crt
  allow_insecure: false

results:
  fetch_batch_size: 500
  max_rows: 10000
  max_bytes: 10485760
  max_output_bytes: 10485760

logging:
  enabled: true
  file: /var/log/dbeeapp/dbeeapp.log
  level: INFO

failures:
  enabled: true
  file: /var/log/dbeeapp/failures.log
  tag: "[DBeeApp_Failure]"
